# Copy this file to .env and enter the values for the current environment.
# Do not commit .env or share its contents.
APP_ENV=production
APP_URL=https://example.com
APP_TIMEZONE=Asia/Bangkok

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_database_user
DB_PASSWORD="replace-with-a-strong-password"

# Server-side only. Do not place this value in HTML or JavaScript.
OPENWEATHER_API_KEY=replace-with-openweather-api-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key

# This key is intentionally public; it is required by the browser widget.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

GOOGLE_APPS_SCRIPT_DAO_URL=https://script.google.com/macros/s/your-id/exec
GOOGLE_APPS_SCRIPT_DUEAN_URL=https://script.google.com/macros/s/your-id/exec
GOOGLE_APPS_SCRIPT_FA_URL=https://script.google.com/macros/s/your-id/exec
